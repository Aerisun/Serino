{
	http_port {$AERISUN_HTTP_PORT:80}
	https_port {$AERISUN_HTTPS_PORT:443}
}

http://127.0.0.1:8081 {
	root * {$AERISUN_FRONTEND_DIST_DIR:/srv/aerisun/frontend}
	file_server
}

{$AERISUN_DOMAIN:localhost} {
	encode zstd gzip

	route {
		@commentImageUpload path /api/v1/site-interactions/comment-image
		handle @commentImageUpload {
			request_body {
				max_size 3MB
			}
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		# API 后端
		@apiRoutes {
			path {$AERISUN_API_BASE_PATH:/api} {$AERISUN_API_BASE_PATH:/api}/*
		}
		handle @apiRoutes {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		# MCP + Skills 域名安装入口
		@mcpInstallRoutes {
			path /mcp/install /mcp/install/*
		}
		handle @mcpInstallRoutes {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		# 资源文件
		@mediaRoutes {
			path /media /media/*
		}
		handle @mediaRoutes {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /manifest.webmanifest {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /bootstrap.js {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		@seoHtml {
			path / /resume
		}
		handle @seoHtml {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		@seoContentCrawler {
			path /posts /posts/* /notes /notes/* /diary /diary/* /thoughts /excerpts /friends /guestbook
			header_regexp User-Agent (?i)(bot|crawler|spider|crawling|slurp|bingpreview|facebookexternalhit|twitterbot|linkedinbot|discordbot|telegrambot|whatsapp|googlebot|googleother|google-inspectiontool|google-agent|google-notebooklm|google-read-aloud|bingbot|baiduspider|bytespider|doubaobot|oai-searchbot|chatgpt-user|perplexitybot|claude-searchbot|claude-user|curl|wget|python-requests|httpx)
		}
		handle @seoContentCrawler {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		# Waline 评论服务
		@walineRoutes {
			path {$AERISUN_WALINE_BASE_PATH:/waline} {$AERISUN_WALINE_BASE_PATH:/waline}/*
		}
		handle @walineRoutes {
			uri strip_prefix {$AERISUN_WALINE_BASE_PATH:/waline}
			reverse_proxy {$AERISUN_WALINE_UPSTREAM:waline:8360}
		}

		# SEO / Feed XML
		handle /robots.txt {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /llms.txt {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /resume.md {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /sitemap.xml {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /feed.xml {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /rss.xml {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		handle /feeds.xml {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		@feedRoutes {
			path /feeds /feeds/*
		}
		handle @feedRoutes {
			reverse_proxy {$AERISUN_API_UPSTREAM:api:8000}
		}

		# 管理端 SPA
		redir /admin /admin/ 308

		handle_path {$AERISUN_ADMIN_BASE_PATH:/admin/}* {
			root * {$AERISUN_ADMIN_DIST_DIR:/srv/aerisun/admin}

			@hashed path /assets/*
			header @hashed Cache-Control "public, max-age=31536000, immutable"

			@unhashed {
				not path /assets/*
			}
			header @unhashed Cache-Control "no-cache, max-age=0, must-revalidate"

			try_files {path} /index.html
			file_server
		}

		# 前端构建产物
		@frontendStatic {
			path /assets/* /fonts/* /index.html /registerSW.js /sw.js
		}
		handle @frontendStatic {
			root * {$AERISUN_FRONTEND_DIST_DIR:/srv/aerisun/frontend}

			@hashed path /assets/*
			header @hashed Cache-Control "public, max-age=31536000, immutable"

			@unhashed {
				not path /assets/*
			}
			header @unhashed Cache-Control "no-cache, max-age=0, must-revalidate"

			file_server
		}

		# 前端 SPA 只接管 Serino 明确拥有的页面路径。
		@previewPage {
			path /preview
		}
		handle @previewPage {
			root * {$AERISUN_FRONTEND_DIST_DIR:/srv/aerisun/frontend}
			header Cache-Control "no-cache, max-age=0, must-revalidate"
			header X-Robots-Tag "noindex, nofollow"
			try_files /index.html
			file_server
		}

		@frontendSpa {
			path / /posts /posts/* /notes /notes/* /friends /thoughts /diary /diary/* /excerpts /resume /guestbook /calendar
		}
		handle @frontendSpa {
			root * {$AERISUN_FRONTEND_DIST_DIR:/srv/aerisun/frontend}
			header Cache-Control "no-cache, max-age=0, must-revalidate"
			try_files /index.html
			file_server
		}

		# 扩展路由由 Serino 服务转发与 sercli 共同管理，普通升级不会覆盖。
		import routes.d/*.caddy

		handle {
			respond 404
		}
	}
}
